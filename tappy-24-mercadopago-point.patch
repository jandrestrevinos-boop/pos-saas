+/// Una terminal física Point de Mercado Pago vinculada a una sucursal.
+/// Una sucursal, cuando mucho, una terminal (por ahora) — si algún
+/// restaurante necesita varias en la misma sucursal, esto habría que
+/// extenderlo a Terminal[] y elegir cuál usar en el POS.
+model MercadoPagoTerminal {
+  id         String   @id @default(uuid())
+  companyId  String
+  branchId   String   @unique
+  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
+
+  terminalId String // el "id" que regresa terminals/v1/list, ej. "NEWLAND_N950__XXXX"
+  label      String // nombre amigable que le puso el restaurante, ej. "Caja 1"
+  posId      Int?
+  storeId    String?
+  createdAt  DateTime @default(now())
+  updatedAt  DateTime @updatedAt
+
+  @@map("mercadopago_terminals")
+}
+
 enum TableStatus {
   LIBRE
   OCUPADA
