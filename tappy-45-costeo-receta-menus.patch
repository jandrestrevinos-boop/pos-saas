+  extraCostAtSale Decimal @default(0) @db.Decimal(10, 2)
+  menuChoices OrderItemMenuChoice[]
+
   modifiers OrderItemModifier[]
 
   @@index([orderId, roundNumber])
@@ -1142,3 +1154,92 @@ model CompanyBranding {
 
   @@map("company_branding")
 }
