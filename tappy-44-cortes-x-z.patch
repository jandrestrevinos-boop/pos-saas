+  zReport    Json?
+  // true cuando el día se abrió solo con la primera venta (empresa sin "abrir caja obligatorio").
+  autoOpened Boolean @default(false)
+
   movements CashMovement[]
 
+  @@unique([branchId, folio])
   @@index([branchId])
   @@map("cash_registers")
 }
