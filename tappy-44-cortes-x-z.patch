diff --git a/src/app/(company)/cortes-z/cortes-z-client.tsx b/src/app/(company)/cortes-z/cortes-z-client.tsx
new file mode 100644
index 0000000..96c8209
--- /dev/null
+++ b/src/app/(company)/cortes-z/cortes-z-client.tsx
@@ -0,0 +1,168 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Button, Card } from "@/components/ui";
+import { Modal, Field, inputClass } from "@/components/ui/modal";
+import { formatMxn } from "@/lib/format";
+import { CutReportView, PrintButton } from "@/components/cash/cut-report";
+import type { CutReport } from "@/modules/cash/report";
+
+type Cut = {
+  id: string;
+  folio: number | null;
+  branchName: string;
+  openedAt: string;
+  closedAt: string | null;
+  tickets: number;
+  total: number;
+  expectedCash: number | null;
+  countedCash: number | null;
+  difference: number | null;
+};
+type Branch = { id: string; name: string };
+
+function fmt(iso: string | null) {
+  return iso ? new Date(iso).toLocaleString("es-MX", { dateStyle: "short", timeStyle: "short" }) : "—";
+}
+
+export function CortesZClient() {
+  const [cuts, setCuts] = useState<Cut[]>([]);
+  const [branches, setBranches] = useState<Branch[]>([]);
+  const [branchId, setBranchId] = useState("");
+  const [from, setFrom] = useState("");
+  const [to, setTo] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [viewing, setViewing] = useState<CutReport | null>(null);
+  const [opening, setOpening] = useState<string | null>(null);
+
+  async function load() {
+    setLoading(true);
+    setError("");
+    const params = new URLSearchParams();
+    if (branchId) params.set("branchId", branchId);
+    if (from) params.set("from", from);
+    if (to) params.set("to", to);
+    const res = await fetch(`/api/cash/z-history?${params.toString()}`);
+    const data = await res.json();
+    setLoading(false);
+    if (!res.ok) {
+      setError(data.error ?? "No se pudieron cargar los cortes");
+      return;
+    }
+    setCuts(data.cuts);
+    setBranches(data.branches);
+  }
+
+  useEffect(() => {
+    load();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [branchId, from, to]);
+
+  async function view(id: string) {
+    setOpening(id);
+    const res = await fetch(`/api/cash/z-history/${id}`);
+    const data = await res.json();
+    setOpening(null);
+    if (!res.ok) {
+      setError(data.error ?? "No se pudo abrir el corte");
+      return;
+    }
+    setViewing(data.report);
+  }
+
+  return (
+    <div>
+      <div className="flex flex-wrap items-end gap-3 mb-6">
+        {branches.length > 1 && (
+          <div className="w-52">
+            <Field label="Sucursal">
+              <select className={inputClass} value={branchId} onChange={(e) => setBranchId(e.target.value)}>
+                <option value="">Todas</option>
+                {branches.map((b) => (
+                  <option key={b.id} value={b.id}>
+                    {b.name}
+                  </option>
+                ))}
+              </select>
+            </Field>
+          </div>
+        )}
+        <div className="w-44">
+          <Field label="Desde">
+            <input type="date" className={inputClass} value={from} onChange={(e) => setFrom(e.target.value)} />
+          </Field>
+        </div>
+        <div className="w-44">
+          <Field label="Hasta">
+            <input type="date" className={inputClass} value={to} onChange={(e) => setTo(e.target.value)} />
+          </Field>
+        </div>
+      </div>
+
+      {error && <p className="text-sm text-ember-dark bg-ember/10 rounded-md px-3 py-2 mb-4">{error}</p>}
+
+      <Card className="overflow-x-auto">
+        {loading ? (
+          <p className="text-sm text-muted p-5">Cargando...</p>
+        ) : cuts.length === 0 ? (
+          <p className="text-sm text-muted p-5">
+            Todavía no hay cortes Z. Aparecen aquí cuando se cierra un día desde Caja (Corte Z · Cerrar día).
+          </p>
+        ) : (
+          <table className="w-full text-sm">
+            <thead>
+              <tr className="border-b border-line text-left text-xs uppercase tracking-wide text-muted">
+                <th className="px-5 py-3 font-medium">Folio</th>
+                <th className="px-5 py-3 font-medium">Sucursal</th>
+                <th className="px-5 py-3 font-medium">Apertura</th>
+                <th className="px-5 py-3 font-medium">Cierre</th>
+                <th className="px-5 py-3 font-medium">Tickets</th>
+                <th className="px-5 py-3 font-medium">Total</th>
+                <th className="px-5 py-3 font-medium">Diferencia</th>
+                <th className="px-5 py-3 font-medium"></th>
+              </tr>
+            </thead>
+            <tbody>
+              {cuts.map((c) => {
+                const exact = c.difference !== null && Math.abs(c.difference) < 0.01;
+                return (
+                  <tr key={c.id} className="border-b border-line last:border-0">
+                    <td className="px-5 py-3 font-mono font-semibold">Z-{c.folio}</td>
+                    <td className="px-5 py-3">{c.branchName}</td>
+                    <td className="px-5 py-3 text-muted text-xs">{fmt(c.openedAt)}</td>
+                    <td className="px-5 py-3 text-muted text-xs">{fmt(c.closedAt)}</td>
+                    <td className="px-5 py-3 font-mono">{c.tickets}</td>
+                    <td className="px-5 py-3 font-mono">{formatMxn(c.total)}</td>
+                    <td
+                      className={`px-5 py-3 font-mono ${
+                        c.difference === null ? "" : exact ? "text-sage" : "text-ember-dark"
+                      }`}
+                    >
+                      {c.difference === null ? "—" : exact ? "Cuadró" : formatMxn(c.difference)}
+                    </td>
+                    <td className="px-5 py-3 text-right">
+                      <Button variant="ghost" onClick={() => view(c.id)} disabled={opening === c.id}>
+                        {opening === c.id ? "Abriendo..." : "Ver"}
+                      </Button>
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        )}
+      </Card>
+
+      {viewing && (
+        <Modal open onClose={() => setViewing(null)} title={`Corte Z${viewing.folio ? ` · Folio ${viewing.folio}` : ""}`}>
+          <CutReportView report={viewing} />
+          <div className="no-print flex justify-end gap-2 mt-5">
+            <PrintButton />
+            <Button onClick={() => setViewing(null)}>Cerrar</Button>
+          </div>
+        </Modal>
+      )}
+    </div>
+  );
+}
