-  orders Order[]
-
+  // Programa de clientes frecuentes (opcional: solo se llena si el cliente
+  // se registró en el programa). cardToken es el contenido del QR personal
+  // (largo y aleatorio, no adivinable); shortCode es el respaldo corto que
+  // el cajero puede teclear si la cámara falla.
+  cardToken       String?   @unique
+  shortCode       String?
+  visitsInCycle   Int       @default(0)
+  lastVisitAt     DateTime?
+  loyaltyJoinedAt DateTime?
+
