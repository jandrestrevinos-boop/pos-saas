+
+/// Existencia de un producto EN UNA SUCURSAL. Es la fuente de verdad del
+/// inventario. Product.stock se mantiene como el TOTAL de todas las sucursales
+/// (suma) para que lo que lee el stock total siga funcionando.
+/// Si no hay fila para (producto, sucursal), la existencia ahí es 0.
+model BranchStock {
+  id        String   @id @default(uuid())
+  productId String
+  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
+  branchId  String
+  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
+  stock     Int      @default(0)
+  updatedAt DateTime @updatedAt
+
+  @@unique([productId, branchId])
+  @@index([branchId])
+  @@map("branch_stocks")
+}
+
+/// Traspaso de mercancía de una sucursal a otra (inmediato). Además de este
+/// registro se generan dos InventoryMovement (salida y entrada) para el historial.
+model StockTransfer {
+  id           String   @id @default(uuid())
+  companyId    String
+  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
+  productId    String
+  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
+  fromBranchId String
+  fromBranch   Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
+  toBranchId   String
+  toBranch     Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
+  userId       String
+  user         User     @relation(fields: [userId], references: [id])
+
+  quantity  Int
+  note      String?
+  createdAt DateTime @default(now())
+
+  @@index([companyId, createdAt])
+  @@map("stock_transfers")
+}
