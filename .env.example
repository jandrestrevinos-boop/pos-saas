# Base de datos (local durante desarrollo, luego apuntará a Postgres cloud)
DATABASE_URL="postgresql://usuario:password@localhost:5432/pos_saas?schema=public"

# NextAuth
NEXTAUTH_SECRET="genera-un-secreto-largo-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Mercado Pago — credenciales de la APLICACIÓN de Tappy (la que Jose ya
# registró en su cuenta de developers.mercadopago.com), NO las de cada
# restaurante. Cada restaurante conecta SU PROPIA cuenta vía OAuth Connect
# desde Configuración → Integraciones; su dinero va directo a ellos.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Debe coincidir EXACTO con la "Redirect URI" configurada en la app de
# Mercado Pago. En producción: https://www.tappysoftware.com/api/mercadopago/oauth/callback
MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/mercadopago/oauth/callback"
