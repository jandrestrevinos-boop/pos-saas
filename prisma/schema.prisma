// ============================================================
// POS SaaS Multiempresa — Esquema de base de datos (Fase 1)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// TENANCY / PLATAFORMA
// ------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  legalName String?
  taxId     String? // RFC (para cuando se integre facturación)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  whatsAppConfigs   WhatsAppConfig[]
  whatsAppSessions  WhatsAppSession[]

  branches      Branch[]
  users         User[]
  categories    Category[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  hardwareFinancings HardwareFinancing[]
  mercadoPagoAccount MercadoPagoAccount?

  @@map("companies")
}

/// Credenciales OAuth Connect de la cuenta de Mercado Pago de CADA
/// restaurante (no la de Jose). El dinero de las ventas del restaurante
/// entra directo a esta cuenta — Tappy nunca es intermediario del dinero,
/// solo genera el cobro usando este token. Ver src/modules/mercadoPago/.
model MercadoPagoAccount {
  id           String   @id @default(uuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  mpUserId     String // collector id del vendedor en Mercado Pago
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  publicKey    String?
  liveMode     Boolean  @default(true)
  expiresAt    DateTime // access_token vence (~180 días); se refresca sola en getValidAccessToken()
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("mercadopago_accounts")
}
enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Configuraci\u00f3n de la plataforma (fila \u00fanica / singleton). Empieza solo
/// con la pol\u00edtica de cancelaci\u00f3n (secci\u00f3n 10 de la spec de
/// financiamiento), pensada para crecer con m\u00e1s reglas comerciales.
model PlatformSettings {
  id String @id @default(uuid())

  // true (default): una empresa con saldo de hardware pendiente NO puede
  // cancelar su suscripci\u00f3n de TAPI hasta liquidarlo.
  // false: se permite cancelar de todos modos (override de regla comercial),
  // el saldo/calendario/historial de financiamiento se conserva intacto,
  // solo deja de bloquear la cancelaci\u00f3n.
  blockCancellationWithPendingFinancing Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  whatsAppConfigs WhatsAppConfig[]

  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  orders             Order[]
  cashRegisters      CashRegister[]
  inventoryMovements InventoryMovement[]
  tables             Table[]
  mercadoPagoTerminal MercadoPagoTerminal?

  @@index([companyId])
  @@map("branches")
}

/// Una terminal física Point de Mercado Pago vinculada a una sucursal.
/// Una sucursal, cuando mucho, una terminal (por ahora) — si algún
/// restaurante necesita varias en la misma sucursal, esto habría que
/// extenderlo a Terminal[] y elegir cuál usar en el POS.
model MercadoPagoTerminal {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String   @unique
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  terminalId String // el "id" que regresa terminals/v1/list, ej. "NEWLAND_N950__XXXX"
  label      String // nombre amigable que le puso el restaurante, ej. "Caja 1"
  posId      Int?
  storeId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("mercadopago_terminals")
}

enum TableStatus {
  LIBRE
  OCUPADA
  CUENTA
  LIMPIEZA
}

model Table {
  id        String   @id @default(uuid())
  companyId String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String // "Mesa 1", "Terraza 3", etc. — texto libre, no solo número
  capacity  Int?
  status    TableStatus @default(LIBRE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Puntero a la cuenta abierta actual de la mesa (si hay una). Es una
  // relación aparte de `orders` (que es el historial completo): una mesa
  // tiene MUCHAS orders a lo largo del tiempo, pero cuando mucho UNA
  // cuenta abierta a la vez.
  currentOrderId String? @unique
  currentOrder   Order?  @relation("TableCurrentOrder", fields: [currentOrderId], references: [id])

  orders Order[] @relation("TableOrders")

  @@index([companyId, branchId])
  @@map("tables")
}

model Plan {
  id             String   @id @default(uuid())
  name           String   @unique // "Básico", "Profesional", "Empresarial"
  maxBranches    Int
  maxUsers       Int
  maxCashRegisters Int
  priceMxn       Decimal  @db.Decimal(10, 2)
  features       Json? // flags de características habilitadas
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String   @id @default(uuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])

  status        SubscriptionStatus @default(TRIALING)
  startDate     DateTime @default(now())
  renewalDate   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  useCustomPlan Boolean @default(false) 
  customPriceMxn Decimal? @db.Decimal(10, 2) 
  customFeatures String[] @default([])

  license License?

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model License {
  id                  String   @id @default(uuid())
  subscriptionId      String   @unique
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  allowedBranches     Int
  allowedCashRegisters Int
  allowedUsers        Int
  createdAt           DateTime @default(now())

  @@map("licenses")
}

// ------------------------------------------------------------
// IDENTIDAD Y PERMISOS
// ------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  companyId    String?  // null solo para SUPER_ADMIN de plataforma
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])

  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders             Order[]
  cashMovements       CashMovement[]
  inventoryMovements  InventoryMovement[]
  auditLogs           AuditLog[]
  hardwareFinancingsCreated HardwareFinancing[]

  @@index([companyId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN_EMPRESA, GERENTE, CAJERO, MESERO
  description String?

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  key    String @unique // "products.create", "cash.close", "reports.view"...
  label  String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------
// CATÁLOGO
// ------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  products Product[]

  @@index([companyId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  whatsAppCartItems WhatsAppCartItem[]

  name        String
  sku         String?
  barcode     String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  tracksInventory Boolean @default(false)
  stock       Int      @default(0)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2) // porcentaje, ej. 16.00
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifierGroups     ProductModifierGroup[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  hardwareFinancingItems HardwareFinancingItem[]

  @@index([companyId])
  @@map("products")
}

model ProductModifierGroup {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String // "Extras", "Opciones"
  minSelect Int     @default(0)
  maxSelect Int     @default(1)

  options ProductModifierOption[]

  @@map("product_modifier_groups")
}

model ProductModifierOption {
  id      String  @id @default(uuid())
  groupId String
  group   ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String // "Queso", "Aguacate"
  extraPrice  Decimal @default(0) @db.Decimal(10, 2)

  orderItemLinks OrderItemModifier[]

  @@map("product_modifier_options")
}

// ------------------------------------------------------------
// OPERACIÓN: PEDIDOS / VENTAS
// ------------------------------------------------------------

model Order {
  id        String   @id @default(uuid())
  localId   String   @unique // UUID generado en cliente, para soporte offline
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  customerId String?
  customer  Customer? @relation(fields: [customerId], references: [id])
  whatsAppCart WhatsAppCart?
  tableId   String?
  table     Table?   @relation("TableOrders", fields: [tableId], references: [id])
  currentForTable Table? @relation("TableCurrentOrder")

  orderNumber Int      @default(autoincrement())
  status      OrderStatus @default(PENDING)
  // true mientras la mesa sigue "consumiendo" (Caja tipo Mesa): se le
  // pueden seguir mandando rondas de productos y todavía no se cobra.
  // false = orden de Mostrador normal, o una mesa ya cerrada/cobrada.
  isOpenTab   Boolean  @default(false)
  orderType   OrderType @default(COMER_AQUI)
  notes       String?  @db.Text // comentarios del cajero: alergias, "sin cebolla", instrucciones, etc.
  deliveryAddress String? @db.Text // solo aplica si orderType = DOMICILIO
  subtotal    Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  tax         Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([companyId, branchId])
  @@index([createdAt])
  @@map("orders")
}

enum OrderType {
  COMER_AQUI
  PARA_LLEVAR
  DOMICILIO
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity        Int
  unitPriceAtSale Decimal @db.Decimal(10, 2) // precio congelado al momento de la venta
  lineTotal       Decimal @db.Decimal(10, 2)

  // Estatus de cocina POR RENGLÓN, no de la orden completa. Antes cocina
  // dependía de Order.status, así que cuando una cuenta abierta (mesa)
  // recibía una ronda nueva, se reabría el status de TODA la orden y
  // cocina volvía a ver los productos de rondas anteriores ya entregadas
  // como si fueran pedido nuevo (duplicado). Ahora cada renglón avanza
  // por su cuenta: PENDING -> IN_PREPARATION -> READY -> DELIVERED.
  status      OrderStatus @default(PENDING)
  // Todos los renglones mandados a cocina juntos en una misma "ronda"
  // comparten este número (1 = primera ronda). En Mostrador siempre es 1.
  // En una mesa con cuenta abierta, cada vez que se agregan productos
  // nuevos se les asigna el siguiente número — así cocina los ve como un
  // ticket aparte, sin tocar los de rondas previas. El cobro sigue siendo
  // uno solo por toda la cuenta (Order.subtotal ya suma todas las rondas).
  roundNumber Int         @default(1)
  createdAt   DateTime    @default(now()) // hora de esta ronda, no la de apertura de la cuenta

  modifiers OrderItemModifier[]

  @@index([orderId, roundNumber])
  @@index([status])
  @@map("order_items")
}

model OrderItemModifier {
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId    String
  option      ProductModifierOption @relation(fields: [optionId], references: [id])
  priceAtSale Decimal @db.Decimal(10, 2)

  @@id([orderItemId, optionId])
  @@map("order_item_modifiers")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Payment {
  id      String  @id @default(uuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method     PaymentMethod
  // Los métodos existentes (CASH/CARD/TRANSFER/OTHER) siempre fueron
  // instantáneos, por eso el default es APPROVED — no cambia nada de su
  // comportamiento actual. Solo MERCADOPAGO nace en PENDING y se confirma
  // (o rechaza) después, vía webhook.
  status     PaymentStatus @default(APPROVED)
  amount     Decimal @db.Decimal(10, 2)
  cashReceived Decimal? @db.Decimal(10, 2)
  change       Decimal? @db.Decimal(10, 2)
  mpPaymentId    String? @unique
  mpPreferenceId String?
  mpPointOrderId String? @unique // id de la orden en la API de Point (Mercado Pago), para consultar/cancelar
  createdAt  DateTime @default(now())

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
  MERCADOPAGO
  MERCADOPAGO_TERMINAL
}

// ------------------------------------------------------------
// CAJA
// ------------------------------------------------------------

model CashRegister {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @db.Decimal(10, 2)
  countedCash Decimal?  @db.Decimal(10, 2)
  expectedCash Decimal? @db.Decimal(10, 2)
  difference   Decimal? @db.Decimal(10, 2)
  status       CashRegisterStatus @default(OPEN)

  movements CashMovement[]

  @@index([branchId])
  @@map("cash_registers")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashMovement {
  id             String @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  userId         String
  user           User @relation(fields: [userId], references: [id])

  type      CashMovementType
  amount    Decimal @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime @default(now())

  @@map("cash_movements")
}

enum CashMovementType {
  SALE
  CASH_IN
  CASH_OUT
  REFUND
}

// ------------------------------------------------------------
// INVENTARIO
// ------------------------------------------------------------

model InventoryMovement {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  type      InventoryMovementType
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  @@map("inventory_movements")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  WASTE
}

// ------------------------------------------------------------
// CLIENTES
// ------------------------------------------------------------

model Customer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  orders Order[]

  @@index([companyId])
  @@map("customers")
}

// ------------------------------------------------------------
// AUDITORÍA
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  action     String // "CREATE", "UPDATE", "DELETE", "LOGIN", "SALE", etc.
  entity     String // "Product", "Order", "CashRegister"...
  entityId   String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
// WhatsApp Orders Models
model WhatsAppConfig {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  phoneNumberId         String
  accessToken           String   @db.Text
  webhookSecret         String?
  isEnabled             Boolean  @default(true)
  welcomeMessage        String   @default("Hola! Bienvenido a nuestro restaurante")
  cartExpirationMinutes Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, phoneNumberId])
  @@index([companyId])
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  phoneNumber String
  customerId String?
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  state     String   @default("BROWSING") // BROWSING, IN_CART, CONFIRMING, COMPLETED, ABANDONED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations WhatsAppConversation[]
  carts          WhatsAppCart[]

  @@index([companyId])
  @@index([phoneNumber])
}

model WhatsAppCart {
  id                String   @id @default(cuid())
  sessionId         String
  session           WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status            String   @default("ACTIVE") // ACTIVE, CONFIRMED, ABANDONED, CONVERTED
  subtotal          Float    @default(0)
  discount          Float    @default(0)
  tax               Float    @default(0)
  total             Float    @default(0)
  orderId           String? @unique
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items WhatsAppCartItem[]

  @@index([sessionId])
  @@index([orderId])
}

model WhatsAppCartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        WhatsAppCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Float
  lineTotal   Float
  modifiers   Json?    // Array de {name, value}
  notes       String?
  createdAt   DateTime @default(now())

  @@index([cartId])
  @@index([productId])
}

model WhatsAppConversation {
  id        String   @id @default(cuid())
  sessionId String
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction String   // INCOMING, OUTGOING
  content   String   @db.Text
  messageId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// ------------------------------------------------------------
// FINANCIAMIENTO DE HARDWARE
// ------------------------------------------------------------

enum HardwareFinancingStatus {
  PENDING
  ACTIVE
  PARTIALLY_PAID
  OVERDUE
  LIQUIDATED
  CANCELLED
  RESTRUCTURED
}

enum HardwareFinancingPeriodicity {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum HardwarePaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Financiamiento de hardware de una empresa. Independiente de
/// Subscription: nunca representa un cobro recurrente de software.
model HardwareFinancing {
  id   String @id @default(uuid())
  code String @unique // "HF-000125"

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status      HardwareFinancingStatus       @default(PENDING)
  periodicity HardwareFinancingPeriodicity  @default(MONTHLY)

  // Montos congelados al crear el financiamiento — nunca se recalculan
  // contra el catálogo aunque el precio del producto cambie después.
  hardwareListValue Decimal @db.Decimal(12, 2)
  negotiatedValue   Decimal @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  downPayment       Decimal @default(0) @db.Decimal(12, 2)
  financialCharge   Decimal @default(0) @db.Decimal(12, 2)
  interestRate      Decimal @default(0) @db.Decimal(6, 4)
  financedBalance   Decimal @db.Decimal(12, 2)

  totalInstallments Int
  installmentAmount Decimal @db.Decimal(12, 2)

  firstPaymentDueDate DateTime
  finalPaymentDueDate DateTime?

  paymentsCompleted Int     @default(0)
  remainingBalance  Decimal @db.Decimal(12, 2)

  liquidatedAt DateTime?
  cancelledAt  DateTime?

  restructuredFromId String?
  restructuredFrom   HardwareFinancing?  @relation("HwFinRestructure", fields: [restructuredFromId], references: [id])
  restructuredInto   HardwareFinancing[] @relation("HwFinRestructure")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    HardwareFinancingItem[]
  payments HardwareFinancingPayment[]

  @@index([companyId, status])
  @@map("hardware_financings")
}

/// Línea de hardware con precio NEGOCIADO congelado.
model HardwareFinancingItem {
  id String @id @default(uuid())

  financingId String
  financing   HardwareFinancing @relation(fields: [financingId], references: [id], onDelete: Cascade)

  productId           String?
  product              Product? @relation(fields: [productId], references: [id])
  productName          String
  catalogUnitPrice     Decimal @db.Decimal(12, 2)
  negotiatedUnitPrice  Decimal @db.Decimal(12, 2)
  quantity             Int
  subtotal             Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@map("hardware_financing_items")
}

/// Un pago dentro del calendario de un financiamiento.
model HardwareFinancingPayment {
  id String @id @default(uuid())

  financingId String
  financing   HardwareFinancing @relation(fields: [financingId], references: [id], onDelete: Cascade)

  paymentNumber Int
  dueDate       DateTime
  amount        Decimal @db.Decimal(12, 2)

  status HardwarePaymentStatus @default(PENDING)
  paidAt DateTime?

  mercadoPagoPaymentId String? @unique
  externalReference    String  @unique
  webhookEventId       String?
  paymentMethodNote    String? // ej. "Efectivo", "Transferencia SPEI" — solo cuando se registra manualmente, no vía MP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([financingId, paymentNumber])
  @@index([status, dueDate])
  @@map("hardware_financing_payments")
