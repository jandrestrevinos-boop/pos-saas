+  userTypes: CompanyRoleName[];
+  /** Renombres de rol propios de la vertical (el resto usa BASE_ROLE_LABELS). */
+  roleLabels: Partial<Record<CompanyRoleName, string>>;
+  /** Cómo se llama la pantalla de comandas (menú y encabezado). */
+  kitchenLabel: string;
 }
 
